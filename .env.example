# ---------------------------------------------------------------------------
# Mino-IA — exemple de configuration
# Copier vers .env puis adapter. Ne jamais versionner un fichier .env réel.
# ---------------------------------------------------------------------------

# Environnement : development, staging ou production
MINO_ENV=development

# Écoute de l'API
MINO_HOST=127.0.0.1
MINO_PORT=5000
MINO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Licences (obligatoire pour exposer /predict)
# ---------------------------------------------------------------------------
# Deux méthodes possibles :
#   1. MINO_LICENSE_KEYS contient directement le JSON.
#   2. MINO_LICENSE_KEYS_FILE pointe vers un fichier JSON lisible uniquement
#      par le service.
#
# Format attendu : liste d'objets, ou objet {cle: configuration}.
# Exemple (à décommenter et à remplacer par une clé réellement secrète) :
# MINO_LICENSE_KEYS=[{"key":"REMPLACER-PAR-UNE-CLE-UNIQUE","type":"standard","max_machines":1,"expires":"2027-12-31"}]
MINO_LICENSE_KEYS=
# MINO_LICENSE_KEYS_FILE=/etc/mino-ia/licenses.json

# Base des installations activées (écrite de façon atomique, permissions 600)
MINO_LICENSE_DB=var/license_db.json

# Sel utilisé pour hacher les adresses IP avant stockage.
# Générer une valeur aléatoire : openssl rand -hex 32
MINO_IP_HASH_SALT=REMPLACER-PAR-UN-SEL-ALEATOIRE

# ---------------------------------------------------------------------------
# LLM de rédaction (optionnel — le moteur déterministe fonctionne seul)
# ---------------------------------------------------------------------------
MINO_USE_LLM=0
MINO_MODEL=mistralai/Mistral-7B-Instruct-v0.3
MINO_LOAD_IN_4BIT=1
